APP_NAME=CHECKOUT-SVC
APP_VERSION=v1.0.0
APP_HTTP_PORT=9000
APP_GRPC_PORT=9001

DB_DRIVER=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=checkout_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_MAX_IDLE_CONN=10
DB_MAX_OPEN_CONN=100
DB_MAX_CONN_LIFETIME=60s
DB_SSL_MODE=disable
DB_ENABLE_DEBUG=true

LOGGER_ENABLE=true
LOGGER_ENABLE_STACK_TRACE=false
LOGGER_ENABLE_MASKING=true
LOGGER_MASKING_FIELDS=password,token

RABBIT_MQ_HOST=localhost
RABBIT_MQ_PORT=5672
RABBIT_MQ_USERNAME=guest
RABBIT_MQ_PASSWORD=guest

JAEGER_ENDPOINT=localhost:4318

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
